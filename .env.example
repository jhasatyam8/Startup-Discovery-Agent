# AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
# Configurable Gemini model (defaults to gemini-2.5-flash-lite if not set)
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=

# YouTube Configuration
# If left empty, the pipeline will fall back to using yt-dlp (no API key required)
YOUTUBE_API_KEY=

# Target YouTube Channels (comma-separated list of channel handles, e.g. @Inc42, @YourStoryEdition, @neonman_land)
# If provided, the agent will scan these specific channels in addition to keyword searches
YOUTUBE_CHANNELS=

# Database Settings
# For SQLite MVP: sqlite:///startups.db
# For PostgreSQL: postgresql://user:password@localhost:5432/startups
DATABASE_URL=sqlite:///startups.db

# Google Sheets Configuration
# Path to your Google Service Account service credentials JSON file (e.g. credentials.json)
GOOGLE_SHEETS_CREDENTIALS_JSON=credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=

# Dashboard Settings
PORT=8000
HOST=127.0.0.1

# Pipeline & Scheduler Settings
# Time to run the daily pipeline in HH:MM format
DAILY_RUN_TIME=02:00
# Lookback hours for YouTube search (e.g., search for videos uploaded in the last 24 hours)
SEARCH_LOOKBACK_HOURS=24
# Number of maximum search results to process per keyword/channel per run
MAX_VIDEOS_PER_RUN=15

# Search Keywords (comma-separated) - Indian Focused
SEARCH_KEYWORDS="indian startup funding,indian startup news,venture capital india,indian seed round,series a india,indian startups raised,funding round india,inc42 funding news"

# Verification & Web Search
# Optional Tavily API key for web searching. If empty, uses duckduckgo-search (free)
TAVILY_API_KEY=

# Notifications
# Optional Slack or Discord webhook URL for daily reports
WEBHOOK_URL=

# ---------------------------------------------------------------------------
# LinkedIn Lead Finder (100% Free — no paid tools required)
# ---------------------------------------------------------------------------
# Set to false to disable LinkedIn lead discovery entirely
ENABLE_LEAD_FINDER=true

# Minimum startup confidence_score (0.0–1.0) required before running lead finding.
# Startups below this threshold are skipped to avoid wasting API calls on uncertain data.
LEAD_MIN_CONFIDENCE=0.5

# Seconds to wait between DuckDuckGo search queries (prevents rate limiting).
# Increase this if you see 429/Ratelimit errors from DuckDuckGo.
LEAD_FINDER_DELAY_SECONDS=3

# Comma-separated list of roles to search for. Leave empty to use the default full list.
# Default: Founder, Co-Founder, CEO, CTO, Chief Technology Officer, HR, Head of HR,
#          HR Manager, Talent, Talent Acquisition, Recruiter, Hiring, People Operations
LEAD_FINDER_ROLES=
